---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { activeCategories, categoryLabel } from '../../data/categories';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return activeCategories(articles).map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;

const list = (await getCollection('articles'))
  .filter((a) => a.data.category === category)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const label = categoryLabel(category!);
const categoryPath = `/${category}/`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: site.url },
    {
      '@type': 'ListItem',
      position: 2,
      name: label,
      item: new URL(categoryPath, site.url).toString(),
    },
  ],
};
---

<Layout
  title={label}
  description={`مقالات التصنيف: ${label}`}
  path={categoryPath}
  jsonLd={breadcrumbJsonLd}
>
  <div class="container narrow">
    <div class="breadcrumb">
      <a href="/">الرئيسية</a> / <span class="current">{label}</span>
    </div>
    <h1 class="section-title" style="margin-top: 0.5rem">{label}</h1>

    {
      list.length > 0 ? (
        <div class="article-list">
          {
            list.map((a) => (
              <ArticleCard
                title={a.data.title}
                description={a.data.description}
                date={a.data.date}
                category={a.data.category}
                href={`/${a.data.category}/${a.id}/`}
                headingLevel="h2"
              />
            ))
          }
        </div>
      ) : (
        <p>لا توجد مقالات بعد في هذا التصنيف.</p>
      )
    }
  </div>
</Layout>
