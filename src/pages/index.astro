---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { activeCategories } from '../data/categories';
import { site } from '../data/site';

const allArticles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const featured = allArticles.filter((a) => a.data.featured).slice(0, 6);

const gridCategories = activeCategories(allArticles);

const countFor = (slug: string) => allArticles.filter((a) => a.data.category === slug).length;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
};

const webJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
};
---

<Layout
  title={site.name}
  description={site.description}
  path="/"
  jsonLd={[orgJsonLd, webJsonLd]}
>
  <div class="container">
    <section aria-label="التصنيفات">
      <h1 class="section-title">التصنيفات</h1>
      {
        gridCategories.length > 0 ? (
          <div class="category-grid">
            {
              gridCategories.map((c) => (
                <CategoryCard label={c.label} count={countFor(c.slug)} href={`/${c.slug}/`} />
              ))
            }
          </div>
        ) : (
          <div class="empty-state">
            <p>لا توجد مقالات بعد. أضِف أول مقال في <code>src/content/articles/</code> وسيظهر هنا تلقائيًا.</p>
          </div>
        )
      }
    </section>

    {
      featured.length > 0 && (
        <section aria-label="مميزة" style="margin-top: 3rem">
          <h2 class="section-title">مميزة</h2>
          <div class="article-list recommended">
            {
              featured.map((a) => (
                <ArticleCard
                  title={a.data.title}
                  description={a.data.description}
                  date={a.data.date}
                  category={a.data.category}
                  href={`/${a.data.category}/${a.id}/`}
                />
              ))
            }
          </div>
        </section>
      )
    }

    {
      allArticles.length > 0 && (
        <section aria-label="آخر المقالات" style="margin-top: 3rem">
          <h2 class="section-title">آخر المقالات</h2>
          <div class="article-list">
            {
              allArticles.slice(0, 8).map((a) => (
                <ArticleCard
                  title={a.data.title}
                  description={a.data.description}
                  date={a.data.date}
                  category={a.data.category}
                  href={`/${a.data.category}/${a.id}/`}
                />
              ))
            }
          </div>
        </section>
      )
    }
  </div>
</Layout>
